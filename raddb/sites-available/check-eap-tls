# Runs after FreeRADIUS has validated the client certificate chain.
# Reject devices on the panel block list (data/config/blocked-devices), accept the rest.
server check-eap-tls {
	authorize {
		blocked_devices

		if (&control:Auth-Type == Reject) {
			update reply {
				&Reply-Message := "Device %{TLS-Client-Cert-Common-Name} is blocked"
			}
			reject
		}

		update control {
			&Auth-Type := Accept
		}
	}
}
