# EAP config for the Wi-Fi SSID: EAP-TLS (certificate) ONLY. Passwords are not accepted.
eap {
	default_eap_type = tls
	timer_expire = 60
	ignore_unknown_eap_types = no
	cisco_accounting_username_bug = no
	max_sessions = ${max_requests}

	tls-config tls-common {
		# RADIUS server identity (generated or imported on the admin panel)
		private_key_file = ${confdir}/panel-dyn/server.key
		certificate_file = ${confdir}/panel-dyn/server-chain.pem

		# CAs whose client certificates are accepted
		# (uploaded on the admin panel Certificates page)
		ca_file = ${confdir}/panel-dyn/client-ca.pem

		fragment_size = 1024
		include_length = yes
		cipher_list = "DEFAULT"
		cipher_server_preference = no

		# TLS 1.2 is the most reliable EAP-TLS version across Windows builds
		tls_min_version = "1.2"
		tls_max_version = "1.2"

		cache {
			enable = no
		}

		ocsp {
			enable = no
		}
	}

	tls {
		tls = tls-common
		# After the certificate chain is validated, run extra checks (blocked devices)
		virtual_server = check-eap-tls
	}
}
